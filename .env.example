# Use one email provider. Web3Forms is the simplest option.
WEB3FORMS_ACCESS_KEY=

# Alternative email provider (requires a verified sender domain in Resend).
RESEND_API_KEY=
QUOTE_FROM_EMAIL="ACE Website <noreply@your-domain.com>"

# Optional: defaults to quotes@anayglobalservices.com.
QUOTE_TO_EMAIL=quotes@anayglobalservices.com

# Optional canonical public site URL.
NEXT_PUBLIC_SITE_URL=https://anayglobalservices.com
